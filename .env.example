# ============================================================
# LifeOS — environment template
# Copy to .env.local and fill in values.
# ============================================================

# --- Database ---
# Two flavors depending on the target environment.
#
# 1. LOCAL DEV (Postgres container via scripts/local-up.sh):
#    postgres://<user>:<password>@localhost:5433/<db>
#    The container binds to 5433 to avoid collision with system Postgres
#    on Fedora. Use this for `npm run dev` with a fresh container.
#
# 2. SUPABASE (managed Postgres with RLS — ADR-008):
#    Use the connection pooler in transaction mode (port 6543) so
#    withUserContext's SET LOCAL app.user_id scopes correctly per
#    transaction. The session-mode pooler (5432) and direct connection
#    both work too, but transaction mode is the recommended pattern.
#    Format: postgres://<user>:<password>@<host>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://lifeos:lifeos@localhost:5433/lifeos
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- NextAuth ---
# NEXTAUTH_SECRET: generate with `openssl rand -base64 32`
NEXTAUTH_URL=http://localhost:3042
NEXTAUTH_SECRET=

# --- Dev credentials provider (bypass OAuth for local dev) ---
# Set to "true" to enable the credentials provider in development. In
# production this is forced off so only GitHub OAuth is available.
ENABLE_CREDENTIALS_PROVIDER=true

# --- Deployment mode (decoupled from NODE_ENV) ---
# Drives the production-only env strictness in `lib/env.ts` and the dev
# auth gates in `lib/auth.ts` + `app/(auth)/login/page.tsx`. Next.js forces
# NODE_ENV=production on `next start`, which would otherwise block the dev
# auth gates on any Railway-hosted env (including staging).
#
#   production  — strict (default). Credentials off, GitHub OAuth required,
#                 staging endpoints return 404.
#   staging     — credentials on, magic-password user-select on `/login`,
#                 staging endpoints callable, `scripts/seed.ts` allowed.
#   development — same relaxed rules as staging (used for local dev).
LIFEOS_DEPLOYMENT_MODE=development

# --- GitHub OAuth (production auth) ---
# Register the OAuth app at https://github.com/settings/applications
# Homepage URL: $NEXTAUTH_URL  Authorization callback: $NEXTAUTH_URL/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# --- Portal SDK (MrBrooks Admin Portal) ---
# Per docs/INTEGRATION.md and development-standards Section C:
# register via OTK flow at https://portal.mrbrooks.biz, then set the DSN.
# NEXT_PUBLIC_MR_BROOKS_DSN is exposed to the browser bundle.
# MR_BROOKS_DSN stays server-only (server-side traces).
MR_BROOKS_DSN=
NEXT_PUBLIC_MR_BROOKS_DSN=

# Per development-standards Section C: use a project-named env var, NOT
# NODE_ENV (which conflates staging/dev/prod in the portal's dashboards).
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_GIT_SHA=

# --- Sentry runtime (optional; ADR-005 portal SDK integration) ---
# The Sentry SDK reads MR_BROOKS_DSN directly; no SENTRY_DSN required unless
# you want to send to a non-portal ingest as well.
SENTRY_AUTH_TOKEN=

# --- Logging (deferred to beta per release strategy) ---
# When Sentry 8.x structured logs land (or Winston + custom transport
# per MrBrooks canonical INTEGRATION.md §"Logs ingest"), these will
# route logs to the portal's logs surface. Until then, the Sentry SDK
# only ships errors + traces.
# LOG_LEVEL=info

# --- App ---
# Override the default dev port (3042) only when something else has it.
# PORT=3042
